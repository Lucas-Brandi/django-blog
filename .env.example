# Copie para .env:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# --- Django ---
# Gere uma chave com:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Evite o caractere "$" na chave (o Compose o interpreta como variável).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Necessário apenas atrás de HTTPS/proxy. Ex.: https://meusite.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- API REST ---
# Origens autorizadas a consumir a API via navegador (CORS), separadas por vírgula.
# Padrão: o front React (Vite) em http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Tamanho de página padrão da API (paginação).
DJANGO_API_PAGE_SIZE=10

# --- Autenticação (JWT) ---
# URL base do front React. Usada no link do e-mail de reset de senha:
#   ${FRONTEND_URL}/password-reset/confirm/<uid>/<token>
FRONTEND_URL=http://localhost:5173
# Tempo de vida dos tokens JWT.
DJANGO_JWT_ACCESS_MINUTES=30
DJANGO_JWT_REFRESH_DAYS=1
# Rate limiting dos endpoints sensíveis (formato do DRF, ex.: 5/min, 100/hour).
DJANGO_THROTTLE_LOGIN=5/min
DJANGO_THROTTLE_PASSWORD_RESET=5/min

# --- E-mail ---
# Em desenvolvimento o e-mail é impresso no console (docker compose logs backend).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@django-blog.local

# --- Porta no host ---
BACKEND_PORT=8000

# --- PostgreSQL (usado pelo docker-compose) ---
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=troque-esta-senha
